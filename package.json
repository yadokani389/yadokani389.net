{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "yadokani389-net",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "yadokani389's website",
  "author": "yadokani389",
  "license": "MIT",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/prepare-deployment.ts",
    "preview": "astro preview",
    "astro": "astro",
    "generate:og": "node scripts/generate-og.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm textlint && pnpm test && pnpm build && pnpm knip",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.{css,astro,html,svelte,vue}\"",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "textlint": "textlint ./src/content/",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "check:full": "pnpm check && pnpm test:e2e",
    "test:e2e": "playwright test",
    "knip": "knip",
    "deploy": "cf deploy --prebuilt --mode production",
    "deploy:preview": "cf deploy --prebuilt --mode preview",
    "test": "node --test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@cloudflare/build-output-utils": "0.9.0",
    "@cloudflare/config": "0.24.1",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@myriaddreamin/rehype-typst": "0.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "astro-og-canvas": "^0.13.2",
    "budoux": "^0.9.3",
    "canvaskit-wasm": "^0.42.0",
    "cf": "1.0.0-beta.14",
    "daisyui": "^5.7.50",
    "hastscript": "^9.0.1",
    "pagefind": "^1.5.2",
    "remark-denden-ruby": "^0.3.1",
    "remark-gemoji": "^8.0.0",
    "remark-link-card-plus": "^0.8.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^18.0.0",
    "svelte-check": "^4.7.6",
    "textlint": "^15.8.0",
    "textlint-plugin-mdx": "^1.1.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.9.0"
}
