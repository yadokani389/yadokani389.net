---
import type { MarkdownHeading } from "astro";
import ArticleTableOfContents from "./ArticleTableOfContents.astro";
import { Icon } from "astro-icon/components";
import TagList from "../TagList.svelte";
import Budoux from "../Budoux.astro";
import ShareActions from "./ShareActions.astro";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../utils/formatDate";

interface Props {
  headings: MarkdownHeading[];
  title: string;
  description: string;
  date: Date;
  lastmod?: Date;
  tags?: string[];
  tagBasePath?: string;
  backHref: string;
  backLabel: string;
  searchType: "blog" | "works";
  searchLabel: string;
}

const {
  headings,
  title,
  description,
  date,
  lastmod,
  tags = [],
  tagBasePath = null,
  backHref,
  backLabel,
  searchType,
  searchLabel,
} = Astro.props as Props;

const showUpdatedDate =
  lastmod !== undefined && lastmod.getTime() !== date.getTime();
const pagefindDateLabel = formatDate(date);
const pagefindDateValue = date.getTime().toString();
---

<Layout
  title={title}
  description={description}
  ogType="article"
  publishedTime={date.toISOString()}
  modifiedTime={lastmod?.toISOString()}
  tags={tags}
>
  <div
    class="relative mx-auto flex max-w-4xl flex-col gap-6"
    data-pagefind-body
  >
    <div class="sr-only" aria-hidden="true">
      <span data-pagefind-meta={`kind:${searchLabel}`}></span>
      <span data-pagefind-meta={`type:${searchType}`}></span>
      <span data-pagefind-meta={`description:${description}`}></span>
      <span data-pagefind-meta={`dateLabel:${pagefindDateLabel}`}></span>
      <span
        data-pagefind-filter={`type:${searchType}`}
        data-pagefind-sort={`date:${pagefindDateValue}`}
      ></span>
    </div>
    <a
      data-pagefind-ignore
      class="inline-flex items-center gap-2 text-sm font-semibold text-ink-600 hover:text-sage-600"
      href={backHref}
    >
      <Icon name="lucide:arrow-left" class="h-4 w-4" aria-hidden="true" />
      {backLabel}
    </a>
    <header class="space-y-3">
      <h1 data-budoux class="text-3xl font-display text-ink-900 md:text-4xl">
        <Budoux text={title} />
      </h1>
      <p data-budoux class="text-lg text-ink-600">
        <Budoux text={description} />
      </p>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-500">
        <div>
          公開日:
          <time class="ml-1" datetime={date.toISOString()}>
            {formatDate(date)}
          </time>
        </div>
        {showUpdatedDate && lastmod && (
          <div>
            最終更新:
            <time class="ml-1" datetime={lastmod.toISOString()}>
              {formatDate(lastmod)}
            </time>
          </div>
        )}
      </div>
      {tags.length > 0 && <TagList tags={tags} basePath={tagBasePath} />}
    </header>

    <div class="relative">
      <ArticleTableOfContents {headings} />
      <div class="prose max-w-none" data-article-body>
        <slot />
      </div>
    </div>
    <ShareActions title={title} />
    <ShareActions title={title} placement="side" />
  </div>
</Layout>

<style is:global>
  [data-article-body] h2[id],
  [data-article-body] h3[id] {
    scroll-margin-block-start: 7rem;
  }
</style>
