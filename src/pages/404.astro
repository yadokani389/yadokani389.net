---
import Layout from "../layouts/Layout.astro";
import { PAGE_META } from "../seo/pageMeta";
---

<Layout
  title={PAGE_META.notFound.title}
  description={PAGE_META.notFound.description}
>
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-center gap-6 pb-6 text-center">
    <div class="py-16 md:py-24">
      <h1 class="text-6xl font-display text-sage-600 md:text-8xl">404</h1>
      <h2 class="mt-4 text-2xl font-display text-ink-900 md:text-3xl">
        ページが見つかりません
      </h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-ink-600">
        お探しのページは移動または削除された可能性があります。
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          class="inline-flex items-center gap-2 rounded-md bg-sage-600 px-6 py-2.5 text-sm font-semibold text-primary-content transition hover:bg-sage-700"
          href="/"
        >
          トップページへ
        </a>
      </div>
    </div>
  </div>
</Layout>
