---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import EntryCard from "../../components/EntryCard.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import {
  BLOG_INDEX_PAGE_SIZE,
  getPublishedBlogPosts,
} from "../../lib/blog/tags";
import { PAGE_META } from "../../seo/pageMeta";

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedBlogPosts();
  return paginate(posts, { pageSize: BLOG_INDEX_PAGE_SIZE });
}

const { page } = Astro.props as Props;
const title =
  page.currentPage === 1
    ? PAGE_META.blogIndex.title
    : `${PAGE_META.blogIndex.title} ${page.currentPage}`;
---

<Layout title={title} description={PAGE_META.blogIndex.description}>
  <div class="mx-auto flex max-w-5xl flex-col gap-10">
    <header class="space-y-3">
      <p class="text-sm font-semibold text-ink-500">ブログ</p>
      <h1 class="text-3xl font-display text-ink-900 md:text-4xl">Blog</h1>
    </header>

    <div class="grid">
      {page.data.map((entry) => (
        <EntryCard {entry} />
      ))}
    </div>

    <Pagination {page} label="Blogページのページネーション" />
  </div>
</Layout>
