---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import EntryCard from "../../../../components/EntryCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { buildTagIndex, getEntriesByTagName } from "../../../../lib/tags/index";
import Layout from "../../../../layouts/Layout.astro";
import {
  BLOG_TAGS_PAGE_SIZE,
  getPublishedBlogPosts,
} from "../../../../lib/blog/tags";

interface Props {
  page: Page<CollectionEntry<"blog">>;
  tagName: string;
  totalPosts: number;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedBlogPosts();
  const tags = buildTagIndex(posts);

  return tags.flatMap((tag) =>
    paginate(getEntriesByTagName(posts, tag.name), {
      params: { tag: tag.slug },
      props: {
        tagName: tag.name,
        totalPosts: tag.count,
      },
      pageSize: BLOG_TAGS_PAGE_SIZE,
    }),
  );
}

const { page, tagName, totalPosts } = Astro.props as Props;
---

<Layout title={`Blog: #${tagName}`} description={`${tagName} の記事一覧`}>
  <div class="mx-auto flex max-w-5xl flex-col gap-10">
    <a
      class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-ink-600 hover:text-sage-600"
      href="/blog"
    >
      ← Blogに戻る
    </a>

    <header class="space-y-3">
      <p class="text-sm font-semibold text-ink-500">タグ別アーカイブ</p>
      <h1 class="text-3xl font-display text-ink-900 md:text-4xl">#{tagName}</h1>
      <p class="text-sm text-ink-600">{totalPosts}件の記事</p>
    </header>

    <div class="grid">
      {page.data.map((entry) => (
        <EntryCard {entry} />
      ))}
    </div>

    <Pagination {page} label="タグページのページネーション" />
  </div>
</Layout>
