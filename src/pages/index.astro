---
import { getCollection } from "astro:content";
import { SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
import { PAGE_META } from "../seo/pageMeta";
import { formatDate } from "../utils/formatDate";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
const works = (await getCollection("works"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout title={PAGE_META.home.title} description={PAGE_META.home.description}>
  <div class="mx-auto flex max-w-5xl flex-col gap-14 md:gap-16">
    <section class="home-intro">
      <div class="min-w-0">
        <h1 class="home-title">{SITE_TITLE}</h1>
        <p class="mt-5 max-w-xl text-sm leading-loose text-ink-600 md:text-base">
          {PAGE_META.home.description}
        </p>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          <a class="text-link" href="/blog">
            Blogを見る <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/works">
            Worksを見る <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <img
        class="home-avatar"
        src="/favicon.png"
        alt="yadokani389 icon"
        width="160"
        height="160"
      />
    </section>

    <section>
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-medium text-sage-600">最新のブログ</p>
          <h2 class="mt-1 text-3xl">Blog</h2>
        </div>
        <a class="text-link" href="/blog">
          一覧へ <span aria-hidden="true">→</span>
        </a>
      </div>
      <div>
        {posts.map((post) => (
          <a class="content-card home-post group" href={`/blog/${post.id}`}>
            <time
              class="text-xs text-ink-500"
              datetime={post.data.date.toISOString()}
            >
              {formatDate(post.data.date)}
            </time>
            <div>
              <h3 class="text-lg font-medium transition-colors group-hover:text-sage-600 md:text-xl">
                {post.data.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">
                {post.data.description}
              </p>
            </div>
            <span class="home-arrow" aria-hidden="true">
              →
            </span>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <p class="text-xs font-medium text-sage-600">最近の作品</p>
          <h2 class="mt-1 text-3xl">Works</h2>
        </div>
        <a class="text-link" href="/works">
          一覧へ <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="grid gap-x-8 gap-y-6 md:grid-cols-3">
        {works.map((work) => (
          <a class="content-card home-work group" href={`/works/${work.id}`}>
            <time
              class="text-xs text-ink-500"
              datetime={work.data.date.toISOString()}
            >
              {formatDate(work.data.date)}
            </time>
            <h3 class="mt-4 text-xl font-medium transition-colors group-hover:text-sage-600">
              {work.data.title}
            </h3>
            <p class="mt-3 text-sm leading-loose text-ink-600">
              {work.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 3rem;
    border-bottom: 1px solid var(--color-sand-200);
    padding-block: 2.5rem 4rem;
    animation: arrive 400ms ease-out both;
  }

  .home-title {
    font-size: clamp(2.5rem, 7vw, 6rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .home-avatar {
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
  }

  .home-post {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;
    padding-block: 1.75rem;
  }

  .home-post h3 {
    text-wrap: balance;
  }

  .home-work {
    display: flex;
    flex-direction: column;
    border-top: 0;
    padding-block: 1.5rem;
  }

  .home-arrow {
    display: inline-block;
    color: var(--color-ink-500);
    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  a:hover .home-arrow {
    transform: translateX(4px);
    color: var(--color-sage-600);
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .home-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      padding-block: 0.5rem 2.5rem;
    }

    .home-avatar {
      grid-row: 1;
      width: 4.5rem;
      height: 4.5rem;
    }

    .home-post {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem 1rem;
      padding-block: 1.5rem;
    }

    .home-post time {
      grid-column: 1 / -1;
    }
  }
</style>
