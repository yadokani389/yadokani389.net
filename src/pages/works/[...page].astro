---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import EntryCard from "../../components/EntryCard.astro";
import Pagination from "../../components/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import { WORK_INDEX_PAGE_SIZE, getWorks } from "../../lib/works/tags";
import { PAGE_META } from "../../seo/pageMeta";

interface Props {
  page: Page<CollectionEntry<"works">>;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const works = await getWorks();
  return paginate(works, { pageSize: WORK_INDEX_PAGE_SIZE });
}

const { page } = Astro.props as Props;
const title =
  page.currentPage === 1
    ? PAGE_META.worksIndex.title
    : `${PAGE_META.worksIndex.title} ${page.currentPage}`;
---

<Layout title={title} description={PAGE_META.worksIndex.description}>
  <div class="mx-auto flex max-w-5xl flex-col gap-10">
    <header class="space-y-3">
      <p class="text-sm font-semibold text-ink-500">作品まとめ</p>
      <h1 class="text-3xl font-display text-ink-900 md:text-4xl">Works</h1>
    </header>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {page.data.map((entry) => (
        <EntryCard {entry} />
      ))}
    </div>

    <Pagination {page} label="Worksページのページネーション" />
  </div>
</Layout>
