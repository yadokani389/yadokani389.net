---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import EntryCard from "../../../../components/EntryCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { buildTagIndex, getEntriesByTagName } from "../../../../lib/tags/index";
import Layout from "../../../../layouts/Layout.astro";
import { WORK_TAGS_PAGE_SIZE, getWorks } from "../../../../lib/works/tags";

interface Props {
  page: Page<CollectionEntry<"works">>;
  tagName: string;
  totalWorks: number;
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const works = await getWorks();
  const tags = buildTagIndex(works);

  return tags.flatMap((tag) =>
    paginate(getEntriesByTagName(works, tag.name), {
      params: { tag: tag.slug },
      props: {
        tagName: tag.name,
        totalWorks: tag.count,
      },
      pageSize: WORK_TAGS_PAGE_SIZE,
    }),
  );
}

const { page, tagName, totalWorks } = Astro.props as Props;
---

<Layout title={`Works: #${tagName}`} description={`${tagName} の作品一覧`}>
  <div class="mx-auto flex max-w-5xl flex-col gap-10">
    <a
      class="inline-flex w-fit items-center gap-2 text-sm font-semibold text-ink-600 hover:text-sage-600"
      href="/works"
    >
      ← Worksに戻る
    </a>

    <header class="space-y-3">
      <p class="text-sm font-semibold text-ink-500">タグ別アーカイブ</p>
      <h1 class="text-3xl font-display text-ink-900 md:text-4xl">#{tagName}</h1>
      <p class="text-sm text-ink-600">{totalWorks}件の作品</p>
    </header>

    <div class="grid">
      {page.data.map((entry) => (
        <EntryCard {entry} />
      ))}
    </div>

    <Pagination {page} label="タグページのページネーション" />
  </div>
</Layout>
